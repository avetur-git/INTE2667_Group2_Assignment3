# Copy this file to .env for local development.
# DEVELOPMENT values only - not real secrets.
FLASK_ENV=development
SECRET_KEY=dev-secret-key-change-me-0123456789abcdef
JWT_SECRET_KEY=dev-jwt-secret-key-change-me-0123456789abcdef
DATABASE_URL=sqlite:///evoting.db
PORT=3000
JWT_EXPIRES_HOURS=8
BCRYPT_ROUNDS=12
# REQ-01: ballots are stored in their own database file
BALLOT_DATABASE_URL=sqlite:///ballots.db
# REQ-10: security keys for staff logins. Keep false until every staff
# member has registered a key (see docs/REQ-10_WEBAUTHN.md)
MFA_REQUIRED=false
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGINS=http://localhost:3000,http://localhost:9001
# REQ-05: write-once audit archive (MinIO). Leave AUDIT_ARCHIVE_ENDPOINT empty to
# turn archiving off. Use the restricted writer/reader users here, never root.
# docker-compose.yml sets these for the Docker stack (MinIO API on localhost:9100).
AUDIT_ARCHIVE_ENDPOINT=
AUDIT_ARCHIVE_BUCKET=audit-archive
AUDIT_ARCHIVE_ACCESS_KEY=audit-writer
AUDIT_ARCHIVE_SECRET_KEY=change-me-writer-secret
AUDIT_ARCHIVE_READER_ACCESS_KEY=audit-reader
AUDIT_ARCHIVE_READER_SECRET_KEY=change-me-reader-secret
AUDIT_ARCHIVE_BATCH_SIZE=20
AUDIT_ARCHIVE_RETENTION_SECONDS=86400
